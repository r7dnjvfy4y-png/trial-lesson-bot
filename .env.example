# Токен бота, который выдал @BotFather
BOT_TOKEN=

# Ваш личный Telegram ID — сюда будут приходить уведомления о заявках,
# и только с этого аккаунта работают команды /leads, /slots, /today,
# /export, /texts
# Узнать свой ID можно, написав боту @userinfobot
ADMIN_CHAT_ID=

# Часовой пояс преподавателя (все слоты считаются в этом поясе)
TIMEZONE=Europe/Moscow

# Уровни, дни, время и группы расписания задаются НЕ здесь, а в config.py
# (переменные DISPLAY_LEVELS, LEVEL_TO_GROUP, WEEKLY_SCHEDULE) — см. README,
# раздел 6. Все ТЕКСТЫ, которые бот отправляет ученицам, редактируются прямо
# в Telegram командой /texts — тоже без правки .env или кода.

# Максимум учеников в одной группе (на один слот даты+времени)
CAPACITY_PER_SLOT=6

# На сколько календарных дней вперёд искать подходящие субботы/воскресенья.
# Если слот на эту неделю уже заполнен, бот сам предложит то же время на
# следующей неделе — благодаря этому окну поиска.
DAYS_AHEAD=28

# Минимальное количество часов до слота, чтобы его ещё можно было забронировать
MIN_NOTICE_HOURS=3

# Через сколько минут молчания на шаге выбора даты бот мягко напомнит о себе
STALL_TIMEOUT_MINUTES=20

# Необязательно: ссылка на материалы (например, набор Quizlet), которую бот
# присылает кнопкой сразу после подтверждения записи. Можно вписать в любой
# момент — код трогать не нужно, просто добавьте переменную и перезапустите бота.
QUIZLET_LINK=

# Путь к файлу базы данных (на Railway лучше указать путь внутри подключённого Volume, например /data/bot.db)
DB_PATH=bot.db
