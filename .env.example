# Токен бота от @BotFather
BOT_TOKEN=

# Ваш числовой Telegram ID — узнать у @userinfobot.
# Сюда приходят заявки с голосовыми, и только с этого аккаунта работает /admin
ADMIN_CHAT_ID=

# Часовой пояс, в котором указано расписание уроков
TIMEZONE=Europe/Madrid

# Вместимость слота по умолчанию (для новых правил расписания)
DEFAULT_CAPACITY=6

# На сколько дней вперёд открыта запись
DAYS_AHEAD=28

# За сколько часов до урока запись ещё возможна
MIN_NOTICE_HOURS=3

# Сколько минут слот держится за ученицей, пока она записывает голосовое
HOLD_MINUTES=120

# Через сколько минут молчания напомнить о голосовом
VOICE_NUDGE_MINUTES=20

# Путь к базе. На Railway подключите Volume на /data и укажите /data/bot.db
DB_PATH=bot.db

# Расписание, ссылка на урок, материалы и все тексты задаются НЕ здесь,
# а прямо в Telegram — команда /admin.
